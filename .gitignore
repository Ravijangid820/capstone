# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Project data & model artifacts
data/
*.pt
*.pth
*.nii.gz
runs/
lightning_logs/

# FLARE workspace + experiment artifacts
fl_workspace/
results/**/_index_*.csv
results/**/*.pt

# Run artifacts — the committed split manifest under artifacts/splits/ IS tracked;
# per-run logs/checkpoints and the preprocessing cache are not.
artifacts/runs/
artifacts/**/checkpoints/
# Default cache dir (~44 GB when full). See docs/environments.md; override FEDBRATS_CACHE_DIR.
artifacts/cache/
# artifacts/baseline/ is deliberately NOT ignored. It is the frozen "before" snapshot that every
# accuracy claim is measured against (~1 MB of JSONL + a SHA-256 manifest). Ignoring it would
# leave the comparison resting on files that exist on exactly one laptop. See docs/improvements.md.
# Rescore outputs are regenerable from checkpoints, so only the written-up report is tracked.
artifacts/rescore_*/

# The publishable fragment of the walkthrough: same bytes as showcase.html minus the document
# wrapper, regenerated on every build. showcase.html is the tracked deliverable.
artifacts/showcase/showcase.artifact.html
